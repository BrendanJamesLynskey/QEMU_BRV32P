# Buildroot defconfig for the brv32p-linux machine: RV32IMAC (no F or D), soft-float ilp32, musl, BusyBox as init,
# an initramfs as a cpio, Linux built from a pinned tarball, OpenSBI generic platform plus the BRV32P UART driver.
# @LINUX@ and @ROOT@ are replaced by linux/build.sh with the absolute paths of linux/ and of the repo.
BR2_riscv=y
BR2_riscv_custom=y
BR2_RISCV_32=y
BR2_RISCV_ISA_RVM=y
BR2_RISCV_ISA_RVA=y
BR2_RISCV_ISA_RVC=y
BR2_RISCV_ABI_ILP32=y
BR2_PACKAGE_HOST_LINUX_HEADERS_CUSTOM_7_1=y
BR2_TOOLCHAIN_BUILDROOT_MUSL=y
BR2_DL_DIR="@ROOT@/.cache/dl"
BR2_ROOTFS_OVERLAY="@LINUX@/overlay"
BR2_TARGET_GENERIC_GETTY_PORT="hvc0"
BR2_LINUX_KERNEL=y
BR2_LINUX_KERNEL_CUSTOM_VERSION=y
BR2_LINUX_KERNEL_CUSTOM_VERSION_VALUE="7.1.13"
BR2_LINUX_KERNEL_DEFCONFIG="rv32"
BR2_LINUX_KERNEL_CONFIG_FRAGMENT_FILES="@LINUX@/kernel.fragment"
BR2_LINUX_KERNEL_IMAGE=y
BR2_LINUX_KERNEL_DTS_SUPPORT=y
BR2_LINUX_KERNEL_CUSTOM_DTS_PATH="@LINUX@/brv32p-linux.dts"
BR2_TARGET_ROOTFS_CPIO=y
BR2_TARGET_ROOTFS_CPIO_FULL=y
# BR2_TARGET_ROOTFS_TAR is not set
BR2_TARGET_OPENSBI=y
BR2_TARGET_OPENSBI_CUSTOM_VERSION=y
BR2_TARGET_OPENSBI_CUSTOM_VERSION_VALUE="1.8.1"
BR2_TARGET_OPENSBI_PLAT="generic"
BR2_GLOBAL_PATCH_DIR="@LINUX@/patches"
