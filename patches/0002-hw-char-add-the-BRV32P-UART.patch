+system_ss.add(when: 'CONFIG_BRV32P_UART', if_true: files('brv32p_uart.c'))
 system_ss.add(when: 'CONFIG_SH_SCI', if_true: files('sh_serial.c'))
 system_ss.add(when: 'CONFIG_STM32F2XX_USART', if_true: files('stm32f2xx_usart.c'))
 system_ss.add(when: 'CONFIG_STM32L4X5_USART', if_true: files('stm32l4x5_usart.c'))
diff --git a/include/hw/char/brv32p_uart.h b/include/hw/char/brv32p_uart.h
new file mode 100644
index 0000000..7d4723b
--- /dev/null
+++ b/include/hw/char/brv32p_uart.h
@@ -0,0 +1,61 @@
+/*
+ * BRV32P UART
+ *
+ * Copyright (c) 2026 Brendan Lynskey
+ *
+ * Models rtl/periph/uart.v of the BRV32P SoC: a transmit and a receive path,
+ * 8N1, a 16-bit clock divider, and an interrupt that follows "receive data
+ * valid".
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#ifndef HW_CHAR_BRV32P_UART_H
+#define HW_CHAR_BRV32P_UART_H
+
+#include "chardev/char-fe.h"
+#include "hw/core/sysbus.h"
+#include "qom/object.h"
+
+#define TYPE_BRV32P_UART "riscv.brv32p.uart"
+OBJECT_DECLARE_SIMPLE_TYPE(BRV32PUARTState, BRV32P_UART)
+
+/* Register window, in bytes: addr[3:2] selects the register and repeats */
+#define BRV32P_UART_MMIO_SIZE    0x100
+
+#define BRV32P_UART_TXDATA       0x0   /* W: start a transmission */
+#define BRV32P_UART_RXDATA       0x4   /* R: received byte; the read clears rx_valid */
+#define BRV32P_UART_STATUS       0x8   /* R: {overrun, rx_valid, tx_busy} */
+#define BRV32P_UART_CLKDIV       0xc   /* RW: 16-bit divider, reset 867 */
+
+#define BRV32P_UART_STATUS_TX_BUSY    (1 << 0)
+#define BRV32P_UART_STATUS_RX_VALID   (1 << 1)
+#define BRV32P_UART_STATUS_RX_OVERRUN (1 << 2)
+
+#define BRV32P_UART_CLKDIV_RESET 867
+
+struct BRV32PUARTState {
+    /*< private >*/
+    SysBusDevice parent_obj;
+
+    /*< public >*/
+    MemoryRegion mmio;
+    qemu_irq irq;
+    CharFrontend chr;
+
+    /* Clock the divider counts, in Hz (property "clock-frequency") */
+    uint64_t freq;
+
+    uint16_t clk_div;
+    bool tx_busy;
+    bool rx_busy;        /* a frame is being received */
+    bool rx_valid;
+    bool rx_overrun;
+    uint8_t rx_data;
+    uint8_t rx_shift;    /* the byte of the frame being received */
+
+    QEMUTimer *tx_timer;
+    QEMUTimer *rx_timer;
+};
+
+#endif /* HW_CHAR_BRV32P_UART_H */
