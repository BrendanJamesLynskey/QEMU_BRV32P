From 6bde4fd342185a23f00ee73d2af8e48474de18c6 Mon Sep 17 00:00:00 2001
From: Brendan Lynskey <brendanlynskey@googlemail.com>
Date: Tue, 3 Nov 2026 01:17:59 +0000
Subject: [PATCH 3/7] hw/gpio: add the BRV32P GPIO

A model of the 32-pin GPIO of the BRV32P SoC, with a direction register and
a rising-edge interrupt per pin. The pins are exposed as qdev GPIO lines
and as the QOM properties gpio-in and gpio-out.

Signed-off-by: Brendan Lynskey <brendanlynskey@googlemail.com>

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 hw/gpio/Kconfig               |   3 +
 hw/gpio/brv32p_gpio.c         | 258 ++++++++++++++++++++++++++++++++++
 hw/gpio/meson.build           |   1 +
 include/hw/gpio/brv32p_gpio.h |  49 +++++++
 4 files changed, 311 insertions(+)
 create mode 100644 hw/gpio/brv32p_gpio.c
 create mode 100644 include/hw/gpio/brv32p_gpio.h

diff --git a/hw/gpio/Kconfig b/hw/gpio/Kconfig
index a209294..e68e762 100644
--- a/hw/gpio/Kconfig
+++ b/hw/gpio/Kconfig
@@ -13,6 +13,9 @@ config GPIO_PWR
 config SIFIVE_GPIO
     bool
 
+config BRV32P_GPIO
+    bool
+
 config STM32L4X5_GPIO
