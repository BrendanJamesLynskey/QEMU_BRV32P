diff --git a/include/hw/timer/brv32p_timer.h b/include/hw/timer/brv32p_timer.h
new file mode 100644
index 0000000..aabcc60
--- /dev/null
+++ b/include/hw/timer/brv32p_timer.h
@@ -0,0 +1,58 @@
+/*
+ * BRV32P timer
+ *
+ * Copyright (c) 2026 Brendan Lynskey
+ *
+ * Models rtl/periph/timer.v of the BRV32P SoC: a 32-bit counter behind a
+ * 32-bit prescaler, a compare register and a sticky match flag that drives
+ * the machine timer interrupt.
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#ifndef HW_TIMER_BRV32P_TIMER_H
+#define HW_TIMER_BRV32P_TIMER_H
+
+#include "hw/core/sysbus.h"
+#include "qom/object.h"
+
+#define TYPE_BRV32P_TIMER "riscv.brv32p.timer"
+OBJECT_DECLARE_SIMPLE_TYPE(BRV32PTimerState, BRV32P_TIMER)
+
+/* Register window, in bytes: addr[4:2] selects the register and repeats */
+#define BRV32P_TIMER_MMIO_SIZE   0x100
+
+#define BRV32P_TIMER_CTRL        0x00   /* RW: bit 0 enable, bit 1 auto-reload */
+#define BRV32P_TIMER_PRESCALER   0x04   /* RW: a tick every prescaler + 1 cycles */
+#define BRV32P_TIMER_COMPARE     0x08   /* RW: reset 0xffffffff */
+#define BRV32P_TIMER_COUNT       0x0c   /* RW */
+#define BRV32P_TIMER_STATUS      0x10   /* R: bit 0 match flag; write 1 to clear */
+
+#define BRV32P_TIMER_CTRL_ENABLE      (1 << 0)
+#define BRV32P_TIMER_CTRL_AUTO_RELOAD (1 << 1)
+
+struct BRV32PTimerState {
+    /*< private >*/
+    SysBusDevice parent_obj;
+
+    /*< public >*/
+    MemoryRegion mmio;
+    qemu_irq irq;
+
+    /* Clock the counters run on, in Hz (property "clock-frequency") */
+    uint64_t freq;
+
+    bool enable;
+    bool auto_reload;
+    uint32_t prescaler;
+    uint32_t compare;
+    uint32_t count;
+    uint32_t pre_cnt;
+    bool match_flag;
+
+    /* The clock cycle (in virtual time) the registers above are valid at */
+    uint64_t last_cycle;
+    QEMUTimer *timer;
+};
+
+#endif /* HW_TIMER_BRV32P_TIMER_H */
