diff --git a/target/riscv/tcg/insn_trans/trans_xbrvdsp.c.inc b/target/riscv/tcg/insn_trans/trans_xbrvdsp.c.inc
new file mode 100644
index 0000000..783953e
--- /dev/null
+++ b/target/riscv/tcg/insn_trans/trans_xbrvdsp.c.inc
@@ -0,0 +1,216 @@
+/*
+ * RISC-V translation routines for Xbrvdsp, the DSP extension of the BRV32P
+ * core. The semantics are those of the core's Spike model
+ * (tools/spike_xbrvdsp/xbrvdsp.cc); the state and the arithmetic are in
+ * tcg/xbrvdsp_helper.c, the translator only picks the helper and moves the
+ * registers and the program counter.
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+/* rd = f(rs1, rs2) */
+static bool gen_xd_rrd(DisasContext *ctx, arg_xdr *a,
+                       void (*fn)(TCGv, TCGv_env, TCGv, TCGv))
+{
+    TCGv dest = dest_gpr(ctx, a->rd);
+    TCGv src1 = get_gpr(ctx, a->rs1, EXT_NONE);
+    TCGv src2 = get_gpr(ctx, a->rs2, EXT_NONE);
+
+    fn(dest, tcg_env, src1, src2);
+    gen_set_gpr(ctx, a->rd, dest);
+    return true;
+}
+
+/* f(rs1, rs2), no register result */
+static bool gen_xd_rr(DisasContext *ctx, arg_xrr *a,
+                      void (*fn)(TCGv_env, TCGv, TCGv))
+{
+    fn(tcg_env, get_gpr(ctx, a->rs1, EXT_NONE), get_gpr(ctx, a->rs2, EXT_NONE));
+    return true;
+}
+
+/* f(rs1), no register result */
+static bool gen_xd_r(DisasContext *ctx, arg_xr *a, void (*fn)(TCGv_env, TCGv))
+{
+    fn(tcg_env, get_gpr(ctx, a->rs1, EXT_NONE));
+    return true;
+}
+
+/* rd = f(), a read of the unit's state */
+static bool gen_xd_d(DisasContext *ctx, arg_xd *a, void (*fn)(TCGv, TCGv_env))
+{
+    TCGv dest = dest_gpr(ctx, a->rd);
+
+    fn(dest, tcg_env);
+    gen_set_gpr(ctx, a->rd, dest);
+    return true;
+}
+
+/* rd = f(sh): acc.rd and acc.rdh, the shift is the rs2 field */
+static bool gen_xd_ds(DisasContext *ctx, arg_xds *a,
+                      void (*fn)(TCGv, TCGv_env, TCGv_i32))
+{
+    TCGv dest = dest_gpr(ctx, a->rd);
+
+    fn(dest, tcg_env, tcg_constant_i32(a->sh));
+    gen_set_gpr(ctx, a->rd, dest);
+    return true;
+}
+
+/*
+ * The last instruction of a hardware loop body: after it, the next pc is
+ * lp_start while the count is above 1, else the next instruction. The pc is
+ * only known at run time, so the translation block ends here.
+ */
+static bool gen_xd_loop_end(DisasContext *ctx)
+{
+    TCGv pc4 = tcg_temp_new();
+    TCGv next = tcg_temp_new();
+
+    gen_pc_plus_diff(pc4, ctx, 4);
+    gen_helper_xd_loop_next(next, tcg_env, pc4);
+    tcg_gen_mov_tl(cpu_pc, next);
+    lookup_and_goto_ptr(ctx);
+    ctx->base.is_jmp = DISAS_NORETURN;
+    return true;
+}
+
+#define TRANS_XD_RRD(NAME)                                              \
+    static bool trans_xd_##NAME(DisasContext *ctx, arg_xdr *a)         \
+    { return gen_xd_rrd(ctx, a, gen_helper_xd_##NAME); }
+#define TRANS_XD_RR(NAME)                                               \
+    static bool trans_xd_##NAME(DisasContext *ctx, arg_xrr *a)         \
+    { return gen_xd_rr(ctx, a, gen_helper_xd_##NAME); }
+#define TRANS_XD_R(NAME)                                                \
+    static bool trans_xd_##NAME(DisasContext *ctx, arg_xr *a)          \
+    { return gen_xd_r(ctx, a, gen_helper_xd_##NAME); }
+#define TRANS_XD_D(NAME)                                                \
+    static bool trans_xd_##NAME(DisasContext *ctx, arg_xd *a)          \
+    { return gen_xd_d(ctx, a, gen_helper_xd_##NAME); }
+#define TRANS_XD_DS(NAME)                                               \
+    static bool trans_xd_##NAME(DisasContext *ctx, arg_xds *a)         \
+    { return gen_xd_ds(ctx, a, gen_helper_xd_##NAME); }
+/* a multiply-accumulate that also ends a loop body */
+#define TRANS_XD_RR_LP(NAME)                                            \
+    static bool trans_xd_##NAME##_lp(DisasContext *ctx, arg_xrr *a)    \
+    {                                                                   \
+        gen_xd_rr(ctx, a, gen_helper_xd_##NAME);                        \
+        return gen_xd_loop_end(ctx);                                    \
+    }
+
+TRANS_XD_RR(mac)
+TRANS_XD_RR(dmac)
+TRANS_XD_RR(msu)
+TRANS_XD_RR_LP(mac)
+TRANS_XD_RR_LP(dmac)
+TRANS_XD_RR_LP(msu)
+TRANS_XD_R(acc_set)
+TRANS_XD_R(acc_seth)
+TRANS_XD_DS(acc_rd)
+TRANS_XD_DS(acc_rdh)
+TRANS_XD_D(acc_rdl)
+TRANS_XD_D(acc_rdx)
+TRANS_XD_RRD(sadd)
+TRANS_XD_RRD(ssub)
+TRANS_XD_RRD(radd16)
+TRANS_XD_RRD(rsub16)
+TRANS_XD_RRD(pk16)
+
+TRANS_XD_RRD(gfmul4)
+TRANS_XD_R(gf_cfg)
+TRANS_XD_D(gf_rd)
+
+TRANS_XD_RRD(mqmul2)
+TRANS_XD_RRD(mqadd2)
+TRANS_XD_RRD(mqsub2)
+TRANS_XD_RRD(ctadd2)
+TRANS_XD_RRD(ctsub2)
+TRANS_XD_RRD(gsmul2)
+TRANS_XD_R(mq_cfg)
+TRANS_XD_R(mq_zeta)
+TRANS_XD_D(mq_rd)
+TRANS_XD_D(mq_rdz)
+
+/* ar.set, ar.cfg, ar.mode: arN = rs1 */
+#define TRANS_XD_AR_W(NAME)                                             \
+    static bool trans_xd_##NAME(DisasContext *ctx, arg_xan *a)         \
+    {                                                                   \
+        gen_helper_xd_##NAME(tcg_env, tcg_constant_i32(a->n),           \
+                             get_gpr(ctx, a->rs1, EXT_NONE));           \
+        return true;                                                    \
+    }
+/* ar.rd, ar.rds, ar.rdm: rd = a field of arN */
+#define TRANS_XD_AR_R(NAME)                                             \
+    static bool trans_xd_##NAME(DisasContext *ctx, arg_xad *a)         \
+    {                                                                   \
+        TCGv dest = dest_gpr(ctx, a->rd);                               \
+                                                                        \
+        gen_helper_xd_##NAME(dest, tcg_env, tcg_constant_i32(a->n));    \
+        gen_set_gpr(ctx, a->rd, dest);                                  \
+        return true;                                                    \
+    }
+
+TRANS_XD_AR_W(ar_set)
+TRANS_XD_AR_W(ar_cfg)
+TRANS_XD_AR_W(ar_mode)
+TRANS_XD_AR_R(ar_rd)
+TRANS_XD_AR_R(ar_rds)
+TRANS_XD_AR_R(ar_rdm)
+
+/*
+ * lh.a, lw.a, lhu.a: rd = mem[addr of arN]; then addr steps by the stride. The
+ * load goes first, so that one that traps (misaligned) leaves the register
+ * as it was.
+ */
+static bool gen_xd_ar_load(DisasContext *ctx, arg_xad *a, MemOp memop,
+                           int size)
+{
+    TCGv dest = dest_gpr(ctx, a->rd);
+    TCGv addr = tcg_temp_new();
+
+    memop |= ctx->mo_endianness | MO_ALIGN;
+    decode_save_opc(ctx, 0);
+    tcg_gen_ld32u_tl(addr, tcg_env,
+                     offsetof(CPURISCVState, xdsp_ar_addr) +
+                     a->n * sizeof(uint32_t));
+    tcg_gen_qemu_ld_tl(dest, addr, ctx->mem_idx, memop);
+    gen_helper_xd_ar_step(tcg_env, tcg_constant_i32(a->n),
+                          tcg_constant_i32(size));
+    gen_set_gpr(ctx, a->rd, dest);
+    return true;
+}
+
+static bool trans_xd_lh_a(DisasContext *ctx, arg_xad *a)
+{
+    return gen_xd_ar_load(ctx, a, MO_SW, 2);
+}
+
+static bool trans_xd_lw_a(DisasContext *ctx, arg_xad *a)
+{
+    return gen_xd_ar_load(ctx, a, MO_SL, 4);
+}
+
+static bool trans_xd_lhu_a(DisasContext *ctx, arg_xad *a)
+{
+    return gen_xd_ar_load(ctx, a, MO_UW, 2);
+}
+
+/* lp.setup rs1: lc = rs1, and the body starts at the next instruction */
+static bool trans_xd_lp_setup(DisasContext *ctx, arg_xr *a)
+{
+    TCGv pc4 = tcg_temp_new();
+
+    gen_pc_plus_diff(pc4, ctx, 4);
+    gen_helper_xd_lp_setup(tcg_env, get_gpr(ctx, a->rs1, EXT_NONE), pc4);
+    return true;
+}
+
+static bool trans_xd_lp_end(DisasContext *ctx, arg_xd_lp_end *a)
+{
+    return gen_xd_loop_end(ctx);
+}
+
+TRANS_XD_R(lp_set)
+TRANS_XD_R(lp_sets)
+TRANS_XD_D(lp_rd)
+TRANS_XD_D(lp_rds)
