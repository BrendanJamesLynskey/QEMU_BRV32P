diff --git a/target/riscv/tcg/xbrvdsp_helper.c b/target/riscv/tcg/xbrvdsp_helper.c
new file mode 100644
index 0000000..41f163e
--- /dev/null
+++ b/target/riscv/tcg/xbrvdsp_helper.c
@@ -0,0 +1,404 @@
+/*
+ * Xbrvdsp: the DSP extension of the BRV32P core. State and arithmetic.
+ *
+ * The semantics are those of the core's Spike model
+ * (tools/spike_xbrvdsp/xbrvdsp.cc), which the instructions are checked
+ * against one by one; the RTL (rtl/core/dsp_unit.v, agu.v, loop_unit.v,
+ * gf_unit.v, mq_unit.v) gives the same results.
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#include "qemu/osdep.h"
+#include "cpu.h"
+#include "exec/helper-proto.h"
+
+/* A 32-bit result as a register holds it */
+#define SEXT32(x) ((target_ulong)(int32_t)(x))
+
+static inline int64_t wrap40(int64_t v)       /* keep 40 bits, sign-extended */
+{
+    return (int64_t)((uint64_t)v << 24) >> 24;
+}
+
+static inline int64_t lo16(uint32_t r)
+{
+    return (int16_t)(r & 0xffff);
+}
+
+static inline int64_t hi16(uint32_t r)
+{
+    return (int16_t)((r >> 16) & 0xffff);
+}
+
+/* ---- the multiply-accumulate unit ---- */
+
+void HELPER(xd_mac)(CPURISCVState *env, target_ulong a, target_ulong b)
+{
+    env->xdsp_acc = wrap40(env->xdsp_acc + lo16(a) * lo16(b));
+}
+
+void HELPER(xd_dmac)(CPURISCVState *env, target_ulong a, target_ulong b)
+{
+    env->xdsp_acc = wrap40(env->xdsp_acc + lo16(a) * lo16(b) +
+                           hi16(a) * hi16(b));
+}
+
+void HELPER(xd_msu)(CPURISCVState *env, target_ulong a, target_ulong b)
+{
+    env->xdsp_acc = wrap40(env->xdsp_acc - lo16(a) * lo16(b));
+}
+
+void HELPER(xd_acc_set)(CPURISCVState *env, target_ulong a)
+{
+    env->xdsp_acc = (int32_t)a;
+}
+
+void HELPER(xd_acc_seth)(CPURISCVState *env, target_ulong a)
+{
+    env->xdsp_acc = wrap40((env->xdsp_acc & 0xffffffffLL) |
+                           ((int64_t)(a & 0xff) << 32));
+}
+
+/* (acc + 2^(sh-1)) >> sh, the rounding being 0 for sh = 0 */
+static int64_t acc_rounded_shift(CPURISCVState *env, uint32_t sh)
+{
+    int64_t v = env->xdsp_acc + (sh ? ((int64_t)1 << (sh - 1)) : 0);
+
+    return v >> sh;
+}
+
+target_ulong HELPER(xd_acc_rd)(CPURISCVState *env, uint32_t sh)
+{
+    int64_t v = acc_rounded_shift(env, sh);
+
+    if (v > INT32_MAX) {
+        v = INT32_MAX;
+    }
+    if (v < INT32_MIN) {
+        v = INT32_MIN;
+    }
+    return SEXT32(v);
+}
+
+target_ulong HELPER(xd_acc_rdh)(CPURISCVState *env, uint32_t sh)
+{
+    int64_t v = acc_rounded_shift(env, sh);
+
+    if (v > INT16_MAX) {
+        v = INT16_MAX;
+    }
+    if (v < INT16_MIN) {
+        v = INT16_MIN;
+    }
+    return SEXT32(v);
+}
+
+target_ulong HELPER(xd_acc_rdl)(CPURISCVState *env)
+{
+    return SEXT32(env->xdsp_acc & 0xffffffff);
+}
+
+target_ulong HELPER(xd_acc_rdx)(CPURISCVState *env)
+{
+    return SEXT32(env->xdsp_acc >> 32);
+}
+
+/* ---- saturating and packed arithmetic ---- */
+
+static target_ulong sat32(int64_t v)
+{
+    if (v > INT32_MAX) {
+        v = INT32_MAX;
+    }
+    if (v < INT32_MIN) {
+        v = INT32_MIN;
+    }
+    return SEXT32(v);
+}
+
+target_ulong HELPER(xd_sadd)(CPURISCVState *env, target_ulong a, target_ulong b)
+{
+    return sat32((int64_t)(int32_t)a + (int32_t)b);
+}
+
+target_ulong HELPER(xd_ssub)(CPURISCVState *env, target_ulong a, target_ulong b)
+{
+    return sat32((int64_t)(int32_t)a - (int32_t)b);
+}
+
+/* per 16-bit half, (a +- b) >> 1, signed */
+static target_ulong halves(uint32_t a, uint32_t b, bool sub)
+{
+    int32_t lo = sub ? lo16(a) - lo16(b) : lo16(a) + lo16(b);
+    int32_t hi = sub ? hi16(a) - hi16(b) : hi16(a) + hi16(b);
+
+    return SEXT32(((uint32_t)(hi >> 1) << 16) | ((uint32_t)(lo >> 1) & 0xffff));
+}
+
+target_ulong HELPER(xd_radd16)(CPURISCVState *env, target_ulong a, target_ulong b)
+{
+    return halves(a, b, false);
+}
+
+target_ulong HELPER(xd_rsub16)(CPURISCVState *env, target_ulong a, target_ulong b)
+{
+    return halves(a, b, true);
+}
+
+target_ulong HELPER(xd_pk16)(CPURISCVState *env, target_ulong a, target_ulong b)
+{
+    return SEXT32(((uint32_t)(a & 0xffff) << 16) | (b & 0xffff));
+}
+
+/* ---- GF(2^8), modulo x^8 + poly ---- */
+
+static uint8_t gf_mul(uint8_t poly, uint8_t a, uint8_t b)
+{
+    uint8_t r = 0;
+
+    for (int k = 7; k >= 0; k--) {
+        r = (uint8_t)((r << 1) ^ (r & 0x80 ? poly : 0));
+        if (b & (1u << k)) {
+            r ^= a;
+        }
+    }
+    return r;
+}
+
+target_ulong HELPER(xd_gfmul4)(CPURISCVState *env, target_ulong a, target_ulong b)
+{
+    uint32_t r = 0;
+
+    for (int i = 0; i < 32; i += 8) {
+        r |= (uint32_t)gf_mul(env->xdsp_gf_poly, (uint8_t)(a >> i),
+                              (uint8_t)(b >> i)) << i;
+    }
+    return SEXT32(r);
+}
+
+void HELPER(xd_gf_cfg)(CPURISCVState *env, target_ulong a)
+{
+    env->xdsp_gf_poly = (uint8_t)a;
+}
+
+target_ulong HELPER(xd_gf_rd)(CPURISCVState *env)
+{
+    return env->xdsp_gf_poly;
+}
+
+/* ---- two 16-bit lanes of arithmetic mod q, Montgomery with R = 2^16 ---- */
+
+static uint16_t mq_mont(CPURISCVState *env, uint32_t p)
+{
+    uint32_t m = (uint16_t)(p * env->xdsp_mq_qp);
+    uint64_t t = ((uint64_t)p + (uint64_t)m * env->xdsp_mq_q) >> 16;
+
+    return (uint16_t)(t >= env->xdsp_mq_q ? t - env->xdsp_mq_q : t);
+}
+
+static uint16_t mq_add(CPURISCVState *env, uint16_t a, uint16_t b)
+{
+    uint32_t s = (uint32_t)a + b;
+
+    return (uint16_t)(s >= env->xdsp_mq_q ? s - env->xdsp_mq_q : s);
+}
+
+static uint16_t mq_sub(CPURISCVState *env, uint16_t a, uint16_t b)
+{
+    return (uint16_t)(a >= b ? a - b : a - b + env->xdsp_mq_q);
+}
+
+enum { MQ_MUL, MQ_ADD, MQ_SUB, MQ_CTADD, MQ_CTSUB, MQ_GSMUL };
+
+static target_ulong mq_lanes(CPURISCVState *env, int f, uint32_t a, uint32_t b)
+{
+    uint32_t r = 0;
+
+    for (int i = 0; i < 32; i += 16) {
+        uint16_t x = (uint16_t)(a >> i), y = (uint16_t)(b >> i), v;
+
+        switch (f) {
+        case MQ_MUL:
+            v = mq_mont(env, (uint32_t)x * y);
+            break;
+        case MQ_ADD:
+            v = mq_add(env, x, y);
+            break;
+        case MQ_SUB:
+            v = mq_sub(env, x, y);
+            break;
+        case MQ_CTADD:
+            v = mq_add(env, x, mq_mont(env, (uint32_t)env->xdsp_mq_zeta * y));
+            break;
+        case MQ_CTSUB:
+            v = mq_sub(env, x, mq_mont(env, (uint32_t)env->xdsp_mq_zeta * y));
+            break;
+        default:
+            v = mq_mont(env, (uint32_t)env->xdsp_mq_zeta * mq_sub(env, y, x));
+            break;
+        }
+        r |= (uint32_t)v << i;
+    }
+    return SEXT32(r);
+}
+
+target_ulong HELPER(xd_mqmul2)(CPURISCVState *env, target_ulong a, target_ulong b)
+{
+    return mq_lanes(env, MQ_MUL, a, b);
+}
+
+target_ulong HELPER(xd_mqadd2)(CPURISCVState *env, target_ulong a, target_ulong b)
+{
+    return mq_lanes(env, MQ_ADD, a, b);
+}
+
+target_ulong HELPER(xd_mqsub2)(CPURISCVState *env, target_ulong a, target_ulong b)
+{
+    return mq_lanes(env, MQ_SUB, a, b);
+}
+
+target_ulong HELPER(xd_ctadd2)(CPURISCVState *env, target_ulong a, target_ulong b)
+{
+    return mq_lanes(env, MQ_CTADD, a, b);
+}
+
+target_ulong HELPER(xd_ctsub2)(CPURISCVState *env, target_ulong a, target_ulong b)
+{
+    return mq_lanes(env, MQ_CTSUB, a, b);
+}
+
+target_ulong HELPER(xd_gsmul2)(CPURISCVState *env, target_ulong a, target_ulong b)
+{
+    return mq_lanes(env, MQ_GSMUL, a, b);
+}
+
+/* q = a[15:0], qp = a[31:16], and zeta goes back to 0 */
+void HELPER(xd_mq_cfg)(CPURISCVState *env, target_ulong a)
+{
+    env->xdsp_mq_q = (uint16_t)a;
+    env->xdsp_mq_qp = (uint16_t)((uint32_t)a >> 16);
+    env->xdsp_mq_zeta = 0;
+}
+
+void HELPER(xd_mq_zeta)(CPURISCVState *env, target_ulong a)
+{
+    env->xdsp_mq_zeta = (uint16_t)a;
+}
+
+target_ulong HELPER(xd_mq_rd)(CPURISCVState *env)
+{
+    return SEXT32((uint32_t)env->xdsp_mq_qp << 16 | env->xdsp_mq_q);
+}
+
+target_ulong HELPER(xd_mq_rdz)(CPURISCVState *env)
+{
+    return env->xdsp_mq_zeta;
+}
+
+/* ---- the address registers ---- */
+
+void HELPER(xd_ar_set)(CPURISCVState *env, uint32_t n, target_ulong a)
+{
+    env->xdsp_ar_addr[n & 3] = a;
+}
+
+void HELPER(xd_ar_cfg)(CPURISCVState *env, uint32_t n, target_ulong a)
+{
+    env->xdsp_ar_stride[n & 3] = (uint16_t)a;
+}
+
+void HELPER(xd_ar_mode)(CPURISCVState *env, uint32_t n, target_ulong a)
+{
+    env->xdsp_ar_br[n & 3] = a & 1;
+}
+
+target_ulong HELPER(xd_ar_rd)(CPURISCVState *env, uint32_t n)
+{
+    return SEXT32(env->xdsp_ar_addr[n & 3]);
+}
+
+target_ulong HELPER(xd_ar_rds)(CPURISCVState *env, uint32_t n)
+{
+    return SEXT32((int32_t)(int16_t)env->xdsp_ar_stride[n & 3]);
+}
+
+target_ulong HELPER(xd_ar_rdm)(CPURISCVState *env, uint32_t n)
+{
+    return env->xdsp_ar_br[n & 3] ? 1 : 0;
+}
+
+static uint16_t rev16(uint16_t v)
+{
+    uint16_t r = 0;
+
+    for (int k = 0; k < 16; k++) {
+        if (v & (1u << k)) {
+            r |= 1u << (15 - k);
+        }
+    }
+    return r;
+}
+
+/*
+ * Step address register n after a load of `size` bytes. In bit-reversed mode
+ * the low 16 bits take a reverse-carry addition, which carries from the high
+ * bits to the low ones and stops at the element size.
+ */
+void HELPER(xd_ar_step)(CPURISCVState *env, uint32_t n, uint32_t size)
+{
+    n &= 3;
+    if (env->xdsp_ar_br[n]) {
+        uint16_t lo = rev16((uint16_t)(rev16(env->xdsp_ar_addr[n] & 0xffff) +
+                                       rev16(env->xdsp_ar_stride[n])));
+        uint16_t below = (uint16_t)(size - 1);
+
+        lo = (uint16_t)((lo & ~below) | (env->xdsp_ar_addr[n] & below));
+        env->xdsp_ar_addr[n] = (env->xdsp_ar_addr[n] & 0xffff0000u) | lo;
+    } else {
+        env->xdsp_ar_addr[n] += (uint32_t)(int32_t)(int16_t)env->xdsp_ar_stride[n];
+    }
+}
+
+/* ---- the hardware loop ---- */
+
+void HELPER(xd_lp_setup)(CPURISCVState *env, target_ulong a, target_ulong pc4)
+{
+    env->xdsp_lc = (uint32_t)a;
+    env->xdsp_lp_start = (uint32_t)pc4;
+}
+
+void HELPER(xd_lp_set)(CPURISCVState *env, target_ulong a)
+{
+    env->xdsp_lc = (uint32_t)a;
+}
+
+void HELPER(xd_lp_sets)(CPURISCVState *env, target_ulong a)
+{
+    env->xdsp_lp_start = (uint32_t)a;
+}
+
+target_ulong HELPER(xd_lp_rd)(CPURISCVState *env)
+{
+    return SEXT32(env->xdsp_lc);
+}
+
+target_ulong HELPER(xd_lp_rds)(CPURISCVState *env)
+{
+    return SEXT32(env->xdsp_lp_start);
+}
+
+/*
+ * After the last instruction of a loop body: while lc > 1, count down and go
+ * to lp_start; else lc becomes 0 and execution falls through to pc4. A loop
+ * set up with a count n runs its body n times (once for n = 0 or 1).
+ */
+target_ulong HELPER(xd_loop_next)(CPURISCVState *env, target_ulong pc4)
+{
+    if (env->xdsp_lc > 1) {
+        env->xdsp_lc--;
+        return SEXT32(env->xdsp_lp_start);
+    }
+    env->xdsp_lc = 0;
+    return pc4;
+}
diff --git a/target/riscv/xbrvdsp.decode b/target/riscv/xbrvdsp.decode
new file mode 100644
index 0000000..f199517
--- /dev/null
+++ b/target/riscv/xbrvdsp.decode
@@ -0,0 +1,92 @@
+#
+# Translation routines for the instructions of Xbrvdsp, the DSP extension of
+# the BRV32P core: the multiply-accumulate unit, the address registers and the
+# hardware loop (custom-0 and custom-1), the packed GF(2^8) multiply and the
+# packed arithmetic mod q (custom-0, funct3 101 and 110).
+#
+# The encodings are those of the core's decoder (rtl/core/decoder.v) and of its
+# Spike model (tools/spike_xbrvdsp/xbrvdsp.cc). A field the RTL requires to be
+# zero is fixed to zero here, so that the same words are illegal.
+#
+# SPDX-License-Identifier: GPL-2.0-or-later
+
+# Fields:
+%rs1       15:5
+%rs2       20:5
+%rd         7:5
+%arn_set    7:2          # the address register of ar.set, ar.cfg, ar.mode: rd[1:0]
+%arn_imm   20:2          # ... of the loads and ar.rd, ar.rds, ar.rdm: imm[1:0]
+
+# Argument sets:
+&xrr       rs1 rs2       # two sources, no result
+&xr        rs1           # one source, no result
+&xd        rd            # a result from the unit's state
+&xdr       rd rs1 rs2
+&xds       rd sh         # a result, shifted by the rs2 field
+&xan       n rs1         # address register n, one source
+&xad       rd n          # a result from (or a load through) address register n
+
+# Formats 32:
+@rr        ....... ..... ..... ... ..... ....... &xrr %rs1 %rs2
+@r1        ....... ..... ..... ... ..... ....... &xr %rs1
+@d         ....... ..... ..... ... ..... ....... &xd %rd
+@rrd       ....... ..... ..... ... ..... ....... &xdr %rd %rs1 %rs2
+@rd_sh     ....... ..... ..... ... ..... ....... &xds %rd sh=%rs2
+@ar_w      ....... ..... ..... ... ..... ....... &xan n=%arn_set %rs1
+@ar_ld     ....... ..... ..... ... ..... ....... &xad %rd n=%arn_imm
+
+# *** custom-0: accumulator, saturating and packed arithmetic ***
+# funct7 bit 6 (insn bit 31) marks the last instruction of a hardware loop body
+xd_mac       0000000 ..... ..... 000 00000 0001011 @rr
+xd_dmac      0000001 ..... ..... 000 00000 0001011 @rr
+xd_msu       0000010 ..... ..... 000 00000 0001011 @rr
+xd_mac_lp    1000000 ..... ..... 000 00000 0001011 @rr
+xd_dmac_lp   1000001 ..... ..... 000 00000 0001011 @rr
+xd_msu_lp    1000010 ..... ..... 000 00000 0001011 @rr
+xd_acc_set   0000100 00000 ..... 000 00000 0001011 @r1
+xd_acc_seth  0000101 00000 ..... 000 00000 0001011 @r1
+xd_acc_rd    0000000 ..... 00000 001 ..... 0001011 @rd_sh
+xd_acc_rdh   0000000 ..... 00000 010 ..... 0001011 @rd_sh
+xd_acc_rdl   0000000 00000 00000 011 ..... 0001011 @d
+xd_acc_rdx   0000001 00000 00000 011 ..... 0001011 @d
+xd_sadd      0000000 ..... ..... 100 ..... 0001011 @rrd
+xd_ssub      0000001 ..... ..... 100 ..... 0001011 @rrd
+xd_radd16    0000010 ..... ..... 100 ..... 0001011 @rrd
+xd_rsub16    0000011 ..... ..... 100 ..... 0001011 @rrd
+xd_pk16      0000100 ..... ..... 100 ..... 0001011 @rrd
+
+# *** custom-0: GF(2^8) ***
+xd_gfmul4    0000000 ..... ..... 101 ..... 0001011 @rrd
+xd_gf_cfg    0000001 00000 ..... 101 00000 0001011 @r1
+xd_gf_rd     0000010 00000 00000 101 ..... 0001011 @d
+
+# *** custom-0: arithmetic mod q ***
+xd_mqmul2    0000000 ..... ..... 110 ..... 0001011 @rrd
+xd_mqadd2    0000001 ..... ..... 110 ..... 0001011 @rrd
+xd_mqsub2    0000010 ..... ..... 110 ..... 0001011 @rrd
+xd_ctadd2    0000011 ..... ..... 110 ..... 0001011 @rrd
+xd_ctsub2    0000100 ..... ..... 110 ..... 0001011 @rrd
+xd_gsmul2    0001001 ..... ..... 110 ..... 0001011 @rrd
+xd_mq_cfg    0000101 00000 ..... 110 00000 0001011 @r1
+xd_mq_zeta   0000110 00000 ..... 110 00000 0001011 @r1
+xd_mq_rd     0000111 00000 00000 110 ..... 0001011 @d
+xd_mq_rdz    0001000 00000 00000 110 ..... 0001011 @d
+
+# *** custom-1: address registers ***
+xd_ar_set    0000000 00000 ..... 000 000.. 0101011 @ar_w
+xd_ar_cfg    0000001 00000 ..... 000 000.. 0101011 @ar_w
+xd_ar_mode   0000011 00000 ..... 000 000.. 0101011 @ar_w
+xd_lh_a      0000000 000.. 00000 001 ..... 0101011 @ar_ld
+xd_lw_a      0000000 000.. 00000 010 ..... 0101011 @ar_ld
+xd_lhu_a     0000000 000.. 00000 101 ..... 0101011 @ar_ld
+xd_ar_rd     0000000 000.. 00000 011 ..... 0101011 @ar_ld
+xd_ar_rds    0000000 001.. 00000 011 ..... 0101011 @ar_ld
+xd_ar_rdm    0000000 011.. 00000 011 ..... 0101011 @ar_ld
+
+# *** custom-1: hardware loop ***
+xd_lp_setup  0000000 00000 ..... 110 00000 0101011 @r1
+xd_lp_end    0000000 00000 00000 111 00000 0101011
+xd_lp_set    0000010 00000 ..... 000 00000 0101011 @r1
+xd_lp_sets   0000010 00000 ..... 000 00001 0101011 @r1
+xd_lp_rd     0000000 01000 00000 011 ..... 0101011 @d
+xd_lp_rds    0000000 01001 00000 011 ..... 0101011 @d
