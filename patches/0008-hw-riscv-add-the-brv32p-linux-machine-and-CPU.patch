 riscv_ss.add(files('riscv_hart.c'))
 riscv_ss.add(when: 'CONFIG_BRV32P', if_true: files('brv32p.c'))
+riscv_ss.add(when: 'CONFIG_BRV32P_LINUX', if_true: files('brv32p_linux.c'))
 riscv_ss.add(when: 'CONFIG_OPENTITAN', if_true: files('opentitan.c'))
 riscv_ss.add(when: 'CONFIG_RISCV_VIRT', if_true: files('virt.c'))
 riscv_ss.add(when: 'CONFIG_SHAKTI_C', if_true: files('shakti_c.c'))
diff --git a/include/hw/riscv/brv32p_linux.h b/include/hw/riscv/brv32p_linux.h
new file mode 100644
index 0000000..b66f666
--- /dev/null
+++ b/include/hw/riscv/brv32p_linux.h
@@ -0,0 +1,48 @@
+/*
+ * BRV32P Linux machine
+ *
+ * Copyright (c) 2026 Brendan Lynskey
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#ifndef HW_RISCV_BRV32P_LINUX_H
+#define HW_RISCV_BRV32P_LINUX_H
+
+#include "hw/core/boards.h"
+#include "hw/core/or-irq.h"
+#include "hw/char/brv32p_uart.h"
+#include "hw/gpio/brv32p_gpio.h"
+#include "hw/riscv/riscv_hart.h"
+#include "hw/timer/brv32p_timer.h"
+
+#define TYPE_BRV32P_LINUX_MACHINE MACHINE_TYPE_NAME("brv32p-linux")
+typedef struct BRV32PLinuxState BRV32PLinuxState;
+DECLARE_INSTANCE_CHECKER(BRV32PLinuxState, BRV32P_LINUX_MACHINE,
+                         TYPE_BRV32P_LINUX_MACHINE)
+
+struct BRV32PLinuxState {
+    /*< private >*/
+    MachineState parent_obj;
+
+    /*< public >*/
+    RISCVHartArrayState soc;
+    MemoryRegion sram;
+    MemoryRegion gpio_alias[13];
+    BRV32PGPIOState gpio;
+    BRV32PUARTState uart;
+    BRV32PTimerState timer;
+    OrIRQState ext_irq;
+};
+
+enum {
+    BRV32P_LINUX_DEV_SRAM,
+    BRV32P_LINUX_DEV_GPIO,
+    BRV32P_LINUX_DEV_UART,
+    BRV32P_LINUX_DEV_TIMER,
+    BRV32P_LINUX_DEV_CLINT,
+    BRV32P_LINUX_DEV_TEST,
+    BRV32P_LINUX_DEV_DRAM,
+};
+
+#endif /* HW_RISCV_BRV32P_LINUX_H */
diff --git a/target/riscv/cpu-qom.h b/target/riscv/cpu-qom.h
index c1bcad3..6852deb 100644
--- a/target/riscv/cpu-qom.h
+++ b/target/riscv/cpu-qom.h
@@ -43,6 +43,7 @@
 #define TYPE_RISCV_CPU_RVA23U64         RISCV_CPU_TYPE_NAME("rva23u64")
 #define TYPE_RISCV_CPU_RVA23S64         RISCV_CPU_TYPE_NAME("rva23s64")
 #define TYPE_RISCV_CPU_BRV32P           RISCV_CPU_TYPE_NAME("brv32p")
+#define TYPE_RISCV_CPU_BRV32P_LINUX     RISCV_CPU_TYPE_NAME("brv32p-linux")
 #define TYPE_RISCV_CPU_IBEX             RISCV_CPU_TYPE_NAME("lowrisc-ibex")
 #define TYPE_RISCV_CPU_SHAKTI_C         RISCV_CPU_TYPE_NAME("shakti-c")
 #define TYPE_RISCV_CPU_SIFIVE_E         RISCV_CPU_TYPE_NAME("sifive-e")
diff --git a/target/riscv/cpu.c b/target/riscv/cpu.c
index e549a34..33525b4 100644
--- a/target/riscv/cpu.c
+++ b/target/riscv/cpu.c
@@ -3327,6 +3327,31 @@ static const TypeInfo riscv_cpu_type_infos[] = {
         .cfg.ext_zknh = true
     ),
 
+    /*
+     * brv32p-linux: the brv32p with what Linux needs added (A, S and U modes,
+     * Sv32, the cycle, time and instret counters with their high halves).
+     * It has no PMP, as the brv32p has none.
+     */
+    DEFINE_RISCV_CPU(TYPE_RISCV_CPU_BRV32P_LINUX, TYPE_RISCV_VENDOR_CPU,
+        .misa_mxl_max = MXL_RV32,
+        .misa_ext = RVI | RVM | RVA | RVC | RVS | RVU,
+        .priv_spec = PRIV_VERSION_1_12_0,
+        .cfg.max_satp_mode = VM_1_10_SV32,
+        .cfg.mmu = true,
+        .cfg.ext_zifencei = true,
+        .cfg.ext_zicsr = true,
+        .cfg.ext_zicntr = true,
+        .cfg.misaligned_trap = true,
+
+        .cfg.ext_zbkb = true,
+        .cfg.ext_zbkc = true,
+        .cfg.ext_zbkx = true,
+        .cfg.ext_zknd = true,
+        .cfg.ext_zkne = true,
+        .cfg.ext_zknh = true,
+        .cfg.ext_xbrvdsp = true
+    ),
+
     DEFINE_RISCV_CPU(TYPE_RISCV_CPU_IBEX, TYPE_RISCV_VENDOR_CPU,
         .misa_mxl_max = MXL_RV32,
         .misa_ext = RVI | RVM | RVC | RVU,
