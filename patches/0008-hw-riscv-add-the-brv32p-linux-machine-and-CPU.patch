     default y
diff --git a/hw/riscv/brv32p_linux.c b/hw/riscv/brv32p_linux.c
new file mode 100644
index 0000000..8c32cfa
--- /dev/null
+++ b/hw/riscv/brv32p_linux.c
@@ -0,0 +1,212 @@
+/*
+ * BRV32P Linux machine
+ *
+ * Copyright (c) 2026 Brendan Lynskey
+ *
+ * The BRV32P SoC (see brv32p.c) with the smallest set of additions that
+ * Linux needs, for deciding what a Linux-capable RTL must gain:
+ *
+ *  - an RV32IMAC hart with M, S and U modes, Sv32 and 64-bit counters
+ *    (the brv32p-linux CPU, with the BRV32P custom extensions);
+ *  - an ACLINT (mtime, mtimecmp, msip) in the layout of the SiFive CLINT,
+ *    at 0x20010000, for the timer and software interrupts;
+ *  - 128 MiB of RAM at 0x80000000, decoded fully (no aliasing).
+ *
+ * The 32 KB boot SRAM at 0 (the RTL's reset address) holds the reset vector,
+ * and the GPIO, UART and timer are where the RTL has them. There is no PLIC:
+ * the console is the SBI console of OpenSBI, which drives the BRV32P UART by
+ * polling. The firmware (-bios, OpenSBI fw_dynamic), the kernel (-kernel), the
+ * initramfs (-initrd) and the device tree (-dtb) are loaded as for the virt
+ * machine.
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#include "qemu/osdep.h"
+#include "qemu/units.h"
+#include "qemu/error-report.h"
+#include "qapi/error.h"
+#include "hw/core/boards.h"
+#include "hw/core/loader.h"
+#include "hw/core/qdev-properties.h"
+#include "hw/core/qdev-properties-system.h"
+#include "hw/core/sysbus.h"
+#include "hw/intc/riscv_aclint.h"
+#include "hw/misc/sifive_test.h"
+#include "hw/riscv/boot.h"
+#include "hw/riscv/brv32p_linux.h"
+#include "hw/riscv/machines-qom.h"
+#include "system/device_tree.h"
+#include "system/system.h"
+#include "target/riscv/cpu.h"
+
+static const MemMapEntry brv32p_linux_memmap[] = {
+    [BRV32P_LINUX_DEV_SRAM] =  { 0x00000000, 0x8000 },
+    [BRV32P_LINUX_DEV_GPIO] =  { 0x20000000, 0x100 },
+    [BRV32P_LINUX_DEV_UART] =  { 0x20000100, 0x100 },
+    [BRV32P_LINUX_DEV_TIMER] = { 0x20000200, 0x100 },
+    [BRV32P_LINUX_DEV_CLINT] = { 0x20010000, 0x10000 },
+    [BRV32P_LINUX_DEV_TEST] =  { 0x20020000, 0x1000 },
+    [BRV32P_LINUX_DEV_DRAM] =  { 0x80000000, 128 * MiB },
+};
+
+static void brv32p_linux_machine_init(MachineState *machine)
+{
+    BRV32PLinuxState *s = BRV32P_LINUX_MACHINE(machine);
+    const MemMapEntry *memmap = brv32p_linux_memmap;
+    MemoryRegion *sys_mem = get_system_memory();
+    RISCVBootInfo boot_info;
+    DeviceState *cpu_dev;
+    hwaddr firmware_end_addr, firmware_start;
+    vaddr kernel_start_addr;
+    uint64_t kernel_entry = 0, fdt_load_addr;
+    int i, fdt_size;
+
+    if (machine->ram_size < 4 * MiB ||
+        machine->ram_size > 4 * GiB - memmap[BRV32P_LINUX_DEV_DRAM].base) {
+        error_report("brv32p-linux: RAM size must be 4 MiB to 2 GiB");
+        exit(EXIT_FAILURE);
+    }
+
+    /* The boot SRAM at the RTL's reset address, and the RAM, fully decoded */
+    memory_region_init_ram(&s->sram, NULL, "riscv.brv32p.sram",
+                           memmap[BRV32P_LINUX_DEV_SRAM].size, &error_fatal);
+    memory_region_add_subregion(sys_mem, memmap[BRV32P_LINUX_DEV_SRAM].base,
+                                &s->sram);
+    memory_region_add_subregion(sys_mem, memmap[BRV32P_LINUX_DEV_DRAM].base,
+                                machine->ram);
+
+    object_initialize_child(OBJECT(machine), "soc", &s->soc,
+                            TYPE_RISCV_HART_ARRAY);
+    object_property_set_str(OBJECT(&s->soc), "cpu-type", machine->cpu_type,
+                            &error_abort);
+    object_property_set_int(OBJECT(&s->soc), "num-harts", 1, &error_abort);
+    object_property_set_int(OBJECT(&s->soc), "resetvec",
+                            memmap[BRV32P_LINUX_DEV_SRAM].base, &error_abort);
+    sysbus_realize(SYS_BUS_DEVICE(&s->soc), &error_fatal);
+    cpu_dev = DEVICE(&s->soc.harts[0]);
+
+    /* The BRV32P external interrupt is gpio_irq | uart_irq; there is no PLIC */
+    object_initialize_child(OBJECT(machine), "ext-irq", &s->ext_irq,
+                            TYPE_OR_IRQ);
+    qdev_prop_set_uint16(DEVICE(&s->ext_irq), "num-lines", 2);
+    qdev_realize(DEVICE(&s->ext_irq), NULL, &error_fatal);
+    qdev_connect_gpio_out(DEVICE(&s->ext_irq), 0,
+                          qdev_get_gpio_in(cpu_dev, IRQ_M_EXT));
+
+    /* The ACLINT in the layout of the SiFive CLINT: msip, mtimecmp, mtime */
+    riscv_aclint_swi_create(memmap[BRV32P_LINUX_DEV_CLINT].base, 0, 1, false);
+    riscv_aclint_mtimer_create(memmap[BRV32P_LINUX_DEV_CLINT].base +
+                               RISCV_ACLINT_SWI_SIZE,
+                               RISCV_ACLINT_DEFAULT_MTIMER_SIZE, 0, 1,
+                               RISCV_ACLINT_DEFAULT_MTIMECMP,
+                               RISCV_ACLINT_DEFAULT_MTIME,
+                               RISCV_ACLINT_DEFAULT_TIMEBASE_FREQ, true);
+
+    /*
+     * The power-off register of the SBI reset (a finisher, as in the virt
+     * machine): not part of the RTL, there to end a headless run cleanly
+     */
+    sifive_test_create(memmap[BRV32P_LINUX_DEV_TEST].base);
+
+    /* The BRV32P peripherals, where the RTL has them (as in brv32p.c) */
+    object_initialize_child(OBJECT(machine), "gpio", &s->gpio,
+                            TYPE_BRV32P_GPIO);
+    sysbus_realize(SYS_BUS_DEVICE(&s->gpio), &error_fatal);
+    sysbus_mmio_map(SYS_BUS_DEVICE(&s->gpio), 0,
+                    memmap[BRV32P_LINUX_DEV_GPIO].base);
+    sysbus_connect_irq(SYS_BUS_DEVICE(&s->gpio), 0,
+                       qdev_get_gpio_in(DEVICE(&s->ext_irq), 0));
+    for (i = 0; i < ARRAY_SIZE(s->gpio_alias); i++) {
+        memory_region_init_alias(&s->gpio_alias[i], OBJECT(machine),
+                                 "riscv.brv32p.gpio.alias",
+                                 sysbus_mmio_get_region(SYS_BUS_DEVICE(&s->gpio),
+                                                        0),
+                                 0, memmap[BRV32P_LINUX_DEV_GPIO].size);
+        memory_region_add_subregion(sys_mem,
+            memmap[BRV32P_LINUX_DEV_GPIO].base + (i + 3) * 0x100,
+            &s->gpio_alias[i]);
+    }
+
+    object_initialize_child(OBJECT(machine), "uart", &s->uart,
+                            TYPE_BRV32P_UART);
+    if (serial_hd(0)) {
+        qdev_prop_set_chr(DEVICE(&s->uart), "chardev", serial_hd(0));
+    }
+    sysbus_realize(SYS_BUS_DEVICE(&s->uart), &error_fatal);
+    sysbus_mmio_map(SYS_BUS_DEVICE(&s->uart), 0,
+                    memmap[BRV32P_LINUX_DEV_UART].base);
+    sysbus_connect_irq(SYS_BUS_DEVICE(&s->uart), 0,
+                       qdev_get_gpio_in(DEVICE(&s->ext_irq), 1));
+
+    object_initialize_child(OBJECT(machine), "timer", &s->timer,
+                            TYPE_BRV32P_TIMER);
+    sysbus_realize(SYS_BUS_DEVICE(&s->timer), &error_fatal);
+    sysbus_mmio_map(SYS_BUS_DEVICE(&s->timer), 0,
+                    memmap[BRV32P_LINUX_DEV_TIMER].base);
+    sysbus_connect_irq(SYS_BUS_DEVICE(&s->timer), 0,
+                       qdev_get_gpio_in(cpu_dev, IRQ_M_TIMER));
+
+    /* Boot: firmware at the start of RAM, kernel after it, the DT at the top */
+    if (!machine->dtb) {
+        error_report("brv32p-linux: a device tree is needed (-dtb)");
+        exit(EXIT_FAILURE);
+    }
+    machine->fdt = load_device_tree(machine->dtb, &fdt_size);
+    if (!machine->fdt) {
+        error_report("load_device_tree() failed");
+        exit(EXIT_FAILURE);
+    }
+
+    firmware_start = memmap[BRV32P_LINUX_DEV_DRAM].base;
+    /* The DT describes 128 MiB; -m changes it */
+    qemu_fdt_setprop_cells(machine->fdt, "/memory@80000000", "reg",
+                           memmap[BRV32P_LINUX_DEV_DRAM].base,
+                           (uint32_t)machine->ram_size);
+    riscv_boot_info_init_discontig_mem(&boot_info, &s->soc,
+                                       memmap[BRV32P_LINUX_DEV_DRAM].base,
+                                       machine->ram_size);
+    firmware_end_addr = riscv_find_and_load_firmware(machine, &boot_info,
+        riscv_default_firmware_name(&s->soc), &firmware_start, NULL);
+    if (machine->kernel_filename) {
+        kernel_start_addr = riscv_calc_kernel_start_addr(&boot_info,
+                                                         firmware_end_addr);
+        riscv_load_kernel(machine, &boot_info, kernel_start_addr, true, NULL);
+        kernel_entry = boot_info.image_low_addr;
+    }
+    fdt_load_addr = riscv_compute_fdt_addr(memmap[BRV32P_LINUX_DEV_DRAM].base,
+                                           machine->ram_size, machine,
+                                           &boot_info);
+    riscv_load_fdt(fdt_load_addr, machine->fdt);
+
+    /* The reset vector, in the boot SRAM at 0 (the RTL's reset address) */
+    riscv_setup_rom_reset_vec(machine, &s->soc, firmware_start,
+                              memmap[BRV32P_LINUX_DEV_SRAM].base,
+                              memmap[BRV32P_LINUX_DEV_SRAM].size,
+                              kernel_entry, fdt_load_addr);
+}
+
+static void brv32p_linux_machine_class_init(ObjectClass *oc, const void *data)
+{
+    MachineClass *mc = MACHINE_CLASS(oc);
+
+    mc->desc = "RISC-V BRV32P SoC with the additions Linux needs "
+               "(RV32IMAC, S-mode, Sv32, ACLINT, 128 MiB RAM)";
+    mc->init = brv32p_linux_machine_init;
+    mc->max_cpus = 1;
+    mc->default_cpu_type = TYPE_RISCV_CPU_BRV32P_LINUX;
+    mc->default_ram_id = "riscv.brv32p.dram";
+    mc->default_ram_size = brv32p_linux_memmap[BRV32P_LINUX_DEV_DRAM].size;
+}
+
+static const TypeInfo brv32p_linux_machine_types[] = {
+    {
+        .name           = TYPE_BRV32P_LINUX_MACHINE,
+        .parent         = TYPE_MACHINE,
+        .instance_size  = sizeof(BRV32PLinuxState),
+        .class_init     = brv32p_linux_machine_class_init,
+        .interfaces     = riscv32_machine_interfaces,
+    }
+};
+
+DEFINE_TYPES(brv32p_linux_machine_types)
