 hw/riscv/brv32p_linux.c         | 212 ++++++++++++++++++++++++++++++++
 hw/riscv/meson.build            |   1 +
 include/hw/riscv/brv32p_linux.h |  48 ++++++++
 target/riscv/cpu-qom.h          |   1 +
 target/riscv/cpu.c              |  25 ++++
 6 files changed, 297 insertions(+)
 create mode 100644 hw/riscv/brv32p_linux.c
 create mode 100644 include/hw/riscv/brv32p_linux.h

diff --git a/hw/riscv/Kconfig b/hw/riscv/Kconfig
index 1244208..c901bfa 100644
--- a/hw/riscv/Kconfig
+++ b/hw/riscv/Kconfig
@@ -119,6 +119,16 @@ config BRV32P
     select BRV32P_UART
